# Use with a dedicated staging database and a real secret manager.
NODE_ENV=production
WEB_PORT=8080
DB_DATABASE=hevenops_staging
DB_USER=hevenops_runtime
DB_PASSWORD=inject-from-staging-secret-manager
DB_SSL=true
DATABASE_URL=postgresql://hevenops_runtime:inject-from-staging-secret-manager@staging-db.example.com:5432/hevenops_staging
MIGRATION_DATABASE_URL=postgresql://hevenops_migrator:inject-from-staging-secret-manager@staging-db.example.com:5432/hevenops_staging
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
JWT_SECRET=inject-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
CORS_ORIGIN=https://staging.example.com
LOG_LEVEL=info
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
JOB_POLL_INTERVAL_MS=2000
JOB_LEASE_MS=60000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_MS=5000
RENT_REMINDER_LEAD_DAYS=3
WORKER_HEARTBEAT_TIMEOUT_MS=90000
# Optional; inject this from the secret manager.
# ERROR_TRACKING_WEBHOOK_URL=https://errors.example.com/hooks/hevenops
