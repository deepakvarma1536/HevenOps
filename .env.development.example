# Copy to .env for `docker compose up --build`.
NODE_ENV=development
WEB_PORT=8080
DB_DATABASE=hevenops
DB_USER=hevenops
DB_PASSWORD=replace-with-a-local-only-password
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
JOB_POLL_INTERVAL_MS=2000
JOB_LEASE_MS=60000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_MS=5000
RENT_REMINDER_LEAD_DAYS=3
WORKER_HEARTBEAT_TIMEOUT_MS=90000
# Optional HTTPS endpoint for sanitized exception metadata.
# ERROR_TRACKING_WEBHOOK_URL=https://errors.example.com/hooks/hevenops
