PORT=3000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/hevenops
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hevenops
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
TENANT_AUTH_TOKEN_TTL_HOURS=24
NODE_ENV=development
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
LOG_LEVEL=info
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# JWT_SECRET must be replaced with a random value of at least 32 characters.
# Enable DB_SSL=true in production; CORS_ORIGIN must list exact deployed frontend origins.
# DATABASE_URL takes precedence over DB_* and is recommended in deployed environments.
# DATABASE_URL=postgres://user:password@host:5432/database
# DB_SSL=true
# Use a dedicated disposable database; tests will create and drop tables.
# TEST_DATABASE_URL=postgres://user:password@host:5432/hevenops_test
