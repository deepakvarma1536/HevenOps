{
  "openapi": "3.1.0",
  "info": {
    "title": "HevenOps API",
    "version": "1.0.0",
    "description": "Property operations API. Errors use { error: { code, message, details?, requestId } }. List endpoints return { data, pagination } and support page (default 1), limit (default 25, maximum 100), sortBy (endpoint allow-list), and sortOrder (asc|desc)."
  },
  "servers": [{ "url": "/api" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "IdempotencyKey": { "type": "apiKey", "in": "header", "name": "Idempotency-Key" }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } },
              "requestId": { "type": "string" }
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "required": ["page", "limit", "total", "totalPages"],
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer", "maximum": 100 },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Standard API error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    },
    "requestBodies": {
      "AuthRegister": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email", "password", "organizationName"], "properties": { "name": { "type": "string", "maxLength": 100 }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 8, "maxLength": 128 }, "organizationName": { "type": "string", "maxLength": 100 } }, "additionalProperties": false } } }
      },
      "AuthLogin": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1, "maxLength": 128 } }, "additionalProperties": false } } }
      },
      "TenantLogin": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["identifier", "password"], "properties": { "identifier": { "type": "string", "maxLength": 150 }, "password": { "type": "string", "maxLength": 128 } }, "additionalProperties": false } } }
      },
      "PasswordSetup": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["invitationToken", "newPassword"], "properties": { "invitationToken": { "type": "string", "minLength": 20, "maxLength": 256 }, "newPassword": { "type": "string", "minLength": 8, "maxLength": 128 } }, "additionalProperties": false } } }
      },
      "Name": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 } }, "additionalProperties": false } } }
      },
      "FloorCreate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["propertyId", "name"], "properties": { "propertyId": { "type": "integer", "minimum": 1 }, "name": { "type": "string", "maxLength": 50 } }, "additionalProperties": false } } }
      },
      "FloorUpdate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 50 } }, "additionalProperties": false } } }
      },
      "RoomCreate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["floorId", "room_number"], "properties": { "floorId": { "type": "integer", "minimum": 1 }, "room_number": { "type": "string", "maxLength": 20 }, "room_type": { "type": ["string", "null"], "maxLength": 50 } }, "additionalProperties": false } } }
      },
      "RoomUpdate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["room_number"], "properties": { "room_number": { "type": "string", "minLength": 1, "maxLength": 20 }, "room_type": { "type": ["string", "null"], "maxLength": 50 } }, "additionalProperties": false } } }
      },
      "BedCreate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["roomId", "bed_number"], "properties": { "roomId": { "type": "integer", "minimum": 1 }, "bed_number": { "type": "string", "maxLength": 20 } }, "additionalProperties": false } } }
      },
      "BedStatus": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["VACANT", "OCCUPIED", "MAINTENANCE"] } }, "additionalProperties": false } } }
      },
      "Tenant": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["name", "phone"], "properties": { "name": { "type": "string", "maxLength": 100 }, "phone": { "type": "string", "maxLength": 20 }, "email": { "type": ["string", "null"], "format": "email" } }, "additionalProperties": false } } }
      },
      "StayCreate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["tenantId", "bedId", "moveInDate", "monthly_rent_paise"], "properties": { "tenantId": { "type": "integer", "minimum": 1 }, "bedId": { "type": "integer", "minimum": 1 }, "moveInDate": { "type": "string", "format": "date" }, "monthly_rent_paise": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } } }
      },
      "StayUpdate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["moveInDate"], "properties": { "moveInDate": { "type": "string", "format": "date" } }, "additionalProperties": false } } }
      },
      "Checkout": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "properties": { "moveOutDate": { "type": "string", "format": "date" } }, "additionalProperties": false } } }
      },
      "RatePlan": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["effectiveFrom", "monthly_rent_paise"], "properties": { "effectiveFrom": { "type": "string", "format": "date" }, "monthly_rent_paise": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } } }
      },
      "RentDue": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["stayId", "dueMonth", "amount_paise", "dueDate"], "properties": { "stayId": { "type": "integer", "minimum": 1 }, "dueMonth": { "type": "string", "format": "date" }, "amount_paise": { "type": "integer", "minimum": 1 }, "dueDate": { "type": "string", "format": "date" } }, "additionalProperties": false } } }
      },
      "RentDueGenerate": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["dueMonth", "amount_paise", "dueDate"], "properties": { "dueMonth": { "type": "string", "format": "date" }, "amount_paise": { "type": "integer", "minimum": 1 }, "dueDate": { "type": "string", "format": "date" } }, "additionalProperties": false } } }
      },
      "Payment": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["rentDueId", "amount_paise"], "properties": { "rentDueId": { "type": "integer", "minimum": 1 }, "amount_paise": { "type": "integer", "minimum": 1 }, "payment_method": { "type": "string", "maxLength": 30 }, "reference": { "type": ["string", "null"], "maxLength": 100 } }, "additionalProperties": false } } }
      },
      "PaymentReversal": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["amount_paise", "reason"], "properties": { "amount_paise": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "maxLength": 255 } }, "additionalProperties": false } } }
      },
      "Deposit": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "required": ["stayId", "transactionType", "amount_paise"], "properties": { "stayId": { "type": "integer", "minimum": 1 }, "transactionType": { "type": "string", "enum": ["COLLECT", "REFUND"] }, "amount_paise": { "type": "integer", "minimum": 1 }, "transactionDate": { "type": "string", "format": "date" }, "note": { "type": ["string", "null"], "maxLength": 255 } }, "additionalProperties": false } } }
      },
      "Invite": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "properties": { "purpose": { "type": "string", "enum": ["INVITE", "PASSWORD_RESET"] } }, "additionalProperties": false } } }
      },
      "TenantProfile": {
        "required": true,
        "content": { "application/json": { "schema": { "type": "object", "minProperties": 1, "properties": { "name": { "type": "string", "maxLength": 100 }, "phone": { "type": "string", "maxLength": 20 }, "emergency_contact": { "type": "string", "maxLength": 100 } }, "additionalProperties": false } } }
      }
    },
    "parameters": {
      "page": { "in": "query", "name": "page", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "limit": { "in": "query", "name": "limit", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
      "sortOrder": { "in": "query", "name": "sortOrder", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } }
    }
  },
  "paths": {
    "/health": {
      "get": { "summary": "Check process liveness", "responses": { "200": { "description": "Process is running" } } }
    },
    "/ready": {
      "get": { "summary": "Check database readiness", "responses": { "200": { "description": "Database is reachable" }, "503": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/auth/register": {
      "post": { "summary": "Register an owner and organization", "tags": ["Authentication"], "requestBody": { "$ref": "#/components/requestBodies/AuthRegister" }, "responses": { "201": { "description": "Account created" }, "400": { "$ref": "#/components/responses/ApiError" }, "409": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/auth/login": {
      "post": { "summary": "Sign in as an owner or manager", "tags": ["Authentication"], "requestBody": { "$ref": "#/components/requestBodies/AuthLogin" }, "responses": { "200": { "description": "Authenticated" }, "401": { "$ref": "#/components/responses/ApiError" }, "429": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/auth/me": {
      "get": { "summary": "Get current account", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Account details" } } }
    },
    "/tenant-auth/login": {
      "post": { "summary": "Tenant sign-in", "tags": ["Authentication"], "requestBody": { "$ref": "#/components/requestBodies/TenantLogin" }, "responses": { "200": { "description": "Authenticated" }, "401": { "$ref": "#/components/responses/ApiError" }, "429": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/tenant-auth/setup-password": {
      "post": { "summary": "Set a tenant password with an invite/reset token", "tags": ["Authentication"], "requestBody": { "$ref": "#/components/requestBodies/PasswordSetup" }, "responses": { "200": { "description": "Password set" }, "400": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/organizations": {
      "get": { "summary": "List organizations for the current user", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated organizations" } } }
    },
    "/organizations/{id}": {
      "patch": { "summary": "Rename organization", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Name" }, "responses": { "200": { "description": "Organization updated" } } },
      "delete": { "summary": "Archive organization", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Organization archived" } } }
    },
    "/properties": {
      "get": { "summary": "List properties", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated properties" } } },
      "post": { "summary": "Create property", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Name" }, "responses": { "201": { "description": "Created property" }, "400": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/properties/{id}": {
      "patch": { "summary": "Update property", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Name" }, "responses": { "200": { "description": "Updated property" } } },
      "delete": { "summary": "Archive property", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Property archived" } } }
    },
    "/floors": {
      "get": { "summary": "List floors by property", "security": [{ "BearerAuth": [] }], "parameters": [{ "in": "query", "name": "propertyId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Paginated floors" } } },
      "post": { "summary": "Create floor", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/FloorCreate" }, "responses": { "201": { "description": "Created floor" } } }
    },
    "/floors/{id}": {
      "patch": { "summary": "Rename floor", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/FloorUpdate" }, "responses": { "200": { "description": "Floor updated" } } },
      "delete": { "summary": "Archive floor", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Floor archived" } } }
    },
    "/rooms": {
      "get": { "summary": "List rooms by floor", "security": [{ "BearerAuth": [] }], "parameters": [{ "in": "query", "name": "floorId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Paginated rooms" } } },
      "post": { "summary": "Create room", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RoomCreate" }, "responses": { "201": { "description": "Created room" } } }
    },
    "/rooms/{id}": {
      "patch": { "summary": "Update room", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RoomUpdate" }, "responses": { "200": { "description": "Room updated" } } },
      "delete": { "summary": "Archive room", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Room archived" } } }
    },
    "/beds": {
      "get": { "summary": "List beds by room", "security": [{ "BearerAuth": [] }], "parameters": [{ "in": "query", "name": "roomId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Paginated beds" } } },
      "post": { "summary": "Create bed", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/BedCreate" }, "responses": { "201": { "description": "Created bed" } } }
    },
    "/beds/{id}/status": {
      "patch": { "summary": "Update bed status", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/BedStatus" }, "responses": { "200": { "description": "Bed status updated" } } }
    },
    "/beds/{id}": {
      "delete": { "summary": "Archive bed", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Bed archived" } } }
    },
    "/tenants": {
      "get": { "summary": "List tenants", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated tenant DTOs; password hashes are excluded" } } },
      "post": { "summary": "Create tenant", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Tenant" }, "responses": { "201": { "description": "Created tenant" } } }
    },
    "/tenants/{id}": {
      "get": { "summary": "Get tenant details", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Tenant details" } } },
      "patch": { "summary": "Update tenant", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Tenant" }, "responses": { "200": { "description": "Updated tenant" } } },
      "delete": { "summary": "Archive tenant", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Tenant archived" } } }
    },
    "/tenants/{id}/auth-token": {
      "post": { "summary": "Create tenant invitation or reset token", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Invite" }, "responses": { "201": { "description": "One-time token; deliver through a trusted channel" } } }
    },
    "/tenants/{id}/invite": {
      "post": { "summary": "Create tenant invitation", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Invite" }, "responses": { "201": { "description": "One-time invitation token" } } }
    },
    "/stays": {
      "get": { "summary": "List stays", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated stay DTOs" } } },
      "post": { "summary": "Assign tenant to bed", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/StayCreate" }, "responses": { "201": { "description": "Created stay" } } }
    },
    "/stays/{id}": {
      "get": { "summary": "Get stay", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Stay details" } } },
      "put": { "summary": "Update move-in date", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/StayUpdate" }, "responses": { "200": { "description": "Updated stay" } } }
    },
    "/stays/{id}/checkout": {
      "patch": { "summary": "Check out tenant", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Checkout" }, "responses": { "200": { "description": "Stay checked out" } } }
    },
    "/stays/{id}/rate-plans": {
      "post": { "summary": "Create rate plan", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RatePlan" }, "responses": { "201": { "description": "Rate plan created" } } }
    },
    "/stays/{stayId}/rent-dues": {
      "get": { "summary": "List rent dues for a stay", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated rent dues" } } }
    },
    "/rent-dues": {
      "post": { "summary": "Create rent due", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RentDue" }, "responses": { "201": { "description": "Created rent due" } } }
    },
    "/rent-dues/generate": {
      "post": { "summary": "Generate rent dues for active stays", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RentDueGenerate" }, "responses": { "201": { "description": "Generation summary" } } }
    },
    "/rent-dues/{rentDueId}/summary": {
      "get": { "summary": "Get rent due and payment summary", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Rent due summary" } } }
    },
    "/payments": {
      "get": { "summary": "List payments for rent due", "security": [{ "BearerAuth": [] }], "parameters": [{ "in": "query", "name": "rentDueId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Paginated payments" } } },
      "post": { "summary": "Record payment", "security": [{ "BearerAuth": [] }, { "IdempotencyKey": [] }], "requestBody": { "$ref": "#/components/requestBodies/Payment" }, "responses": { "201": { "description": "Payment recorded" } } }
    },
    "/payments/{id}/reversals": {
      "post": { "summary": "Reverse part of a payment", "security": [{ "BearerAuth": [] }, { "IdempotencyKey": [] }], "requestBody": { "$ref": "#/components/requestBodies/PaymentReversal" }, "responses": { "201": { "description": "Reversal recorded" } } }
    },
    "/deposits": {
      "get": { "summary": "List deposit transactions for stay", "security": [{ "BearerAuth": [] }], "parameters": [{ "in": "query", "name": "stayId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Paginated deposits" } } },
      "post": { "summary": "Collect or refund deposit", "security": [{ "BearerAuth": [] }, { "IdempotencyKey": [] }], "requestBody": { "$ref": "#/components/requestBodies/Deposit" }, "responses": { "201": { "description": "Deposit transaction recorded" } } }
    },
    "/deposits/balance": {
      "get": { "summary": "Get deposit balance for stay", "security": [{ "BearerAuth": [] }], "parameters": [{ "in": "query", "name": "stayId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Balance totals" } } }
    },
    "/tenant-portal/me": {
      "get": { "summary": "Get tenant profile", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Tenant profile" } } },
      "put": { "summary": "Update safe profile fields", "security": [{ "BearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/TenantProfile" }, "responses": { "200": { "description": "Updated profile" } } }
    },
    "/tenant-portal/my-stay": {
      "get": { "summary": "Get current stay", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Current stay or empty stay result" } } }
    },
    "/tenant-portal/my-rent-dues": {
      "get": { "summary": "List tenant rent dues", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated rent dues" } } }
    },
    "/tenant-portal/my-payments": {
      "get": { "summary": "List tenant payments", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated payments" } } }
    },
    "/tenant-portal/my-deposits": {
      "get": { "summary": "List tenant deposits", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Paginated deposits" } } }
    }
  }
}
