{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:unit": "node --test test/*.unit.test.js test/api-hardening.test.js",
    "test:integration": "node scripts/run-db-tests.js test/authorization.integration.test.js test/e2e.integration.test.js",
    "test:e2e": "node scripts/run-db-tests.js test/e2e.integration.test.js",
    "test:coverage": "c8 --all --include='config/env.js' --include='utils/**/*.js' --include='middleware/normalizeApiErrors.js' --include='middleware/validateRequest.js' --check-coverage --lines 65 --functions 55 --branches 45 npm run test:unit",
    "env:check": "node scripts/check-env.js",
    "lint": "eslint .",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:baseline": "node scripts/migrate.js baseline"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
